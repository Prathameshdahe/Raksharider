# DriveTrust AI — Environment Variables Template
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

# ─── NVIDIA NIM (Nemotron VLM tiebreaker) ───────────────────────────
# Get your key: https://build.nvidia.com → API Keys
NVIDIA_NIM_API_KEY=your_nvapi_key_here
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ─── Model Paths (optional overrides) ───────────────────────────────
# COCO_MODEL_PATH=models/yolov8n.pt
# HELMET_MODEL_PATH=models/helmet_model.pt
# PLATE_MODEL_PATH=models/ampr.pt
# VEHICLE_CLASS_MODEL_PATH=models/classifiacation.pt

# ─── Detection Tuning ────────────────────────────────────────────────
# YOLO_CONF_THRESHOLD=0.35
