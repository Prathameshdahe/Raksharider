# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Model weights -- excluded by default; override below for review builds
models/*.pt
models/*.onnx
*.pt
.EasyOCR/
~/.cache/torch/
*.cache/

# Allow specific models for senior review
!models/helmet_model.pt
!models/ampr.pt

# Evidence/output artifacts -- excluded by default
pipeline/evidence_output/
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg

# Allow evidence output for senior review
!pipeline/evidence_output/
!pipeline/evidence_output/**

# Test videos -- excluded by default
tests/sample_videos/*.mp4
tests/sample_videos/*.mov

# Allow sample video for senior review
!tests/sample_videos/sample.mp4

# Environment & secrets
.env
.env.local
*.key
config/secrets.yaml

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
